rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'chandegaraharsh464@gmail.com';
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Public portfolio content (admin writes)
    match /site/{doc}        { allow read: if true; allow write: if isAdmin(); }
    match /experiences/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /projects/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /media/{id}        { allow read: if true; allow write: if isAdmin(); }

    // Collections: visitors only see "Published" ones
    match /collections/{id} {
      allow read: if isAdmin() || resource.data.status == 'Published';
      allow write: if isAdmin();
    }

    // Contact form messages: anyone can send, only admin can read
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'status', 'createdAt'])
        && request.resource.data.status == 'New'
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // Visitor counter: anyone can add +1 to a counter, only admin can read
    function statShape() {
      return request.resource.data.keys().hasOnly(['views', 'newVisitors', 'returningVisits', 'date']);
    }
    match /stats/{id} {
      allow read: if isAdmin();
      allow create: if statShape()
        && request.resource.data.views == 1
        && request.resource.data.newVisitors in [0, 1]
        && request.resource.data.returningVisits in [0, 1];
      allow update: if statShape()
        && request.resource.data.views - resource.data.views == 1
        && request.resource.data.newVisitors - resource.data.newVisitors in [0, 1]
        && request.resource.data.returningVisits - resource.data.returningVisits in [0, 1];
    }

    // Outfit catalog: only logged-in users can see it. Users may only change likedBy.
    match /outfits/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && onlyChanges(['likedBy']));
    }

    // User profiles
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read, update: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Orders: users create "Pending" orders; only admin changes status.
    match /orders/{id} {
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'Pending';
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
                    || (signedIn() && resource.data.userId == request.auth.uid && onlyChanges(['userNotified']));
    }

    // Chat: one thread per user (doc id = user uid)
    match /chats/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
      match /messages/{mid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() &&
          ((request.auth.uid == uid && request.resource.data.from == 'user') || isAdmin());
      }
    }
  }
}
